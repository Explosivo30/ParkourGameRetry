MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 519496727}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0957c605207138f4fbb4af30d73be671, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  player: {fileID: 2139332776}
  gates:
  - title: BAJO LA RED
    hint: 'WASD + raton. Espacio: salta; mantenlo frente a una pared para subir.'
    volume: {fileID: 1038277093}
    spawn: {fileID: 1872554402}
  - title: RODANTES
    hint: Corre + Ctrl para deslizar bajo el conducto. Puedes rodearlo por la derecha.
    volume: {fileID: 1649394552}
    spawn: {fileID: 1320567107}
  - title: CAPA
    hint: Manten Espacio contra las paredes naranjas. Aqui dejamos nuestra huella.
    volume: {fileID: 1645756231}
    spawn: {fileID: 1939015647}
  - title: CANAL ABIERTO
    hint: 'Menta: pasarela izquierda. Amarillo: salta junto al muro para tomar el
      atajo.'
    volume: {fileID: 1273478260}
    spawn: {fileID: 334731140}
  - title: HORIZONTE
    hint: 'Menta: plataformas de la izquierda. Atajo: apunta al anclaje y pulsa clic
      derecho.'
    volume: {fileID: 1649910970}
    spawn: {fileID: 1595916944}
